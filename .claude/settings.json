{
  "permissions": {
    "allow": [
      "Bash(run_python.bat *)",
      "Bash(./run_python.bat *)",
      "Bash(.\\run_python.bat *)",
      "Bash(cmd //c run_python.bat *)",
      "Bash(cmd /c run_python.bat *)",
      "Bash(*run_python.bat*)",
      "Bash(mkdir *)",
      "Bash(explorer.exe *)",
      "Bash(cmd //c start *)",
      "Bash(cmd /c start *)",
      "Write",
      "Edit"
    ],
    "deny": [
      "Bash(git *)",
      "Bash(*git *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-primer-paso.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-notebook-sin-duplicados.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-notebook-graficas-faltantes.cjs\""
          }
        ]
      }
    ]
  }
}
