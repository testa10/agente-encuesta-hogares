{
  "permissions": {
    "allow": [
      "Bash(run_python.bat *)",
      "Bash(./run_python.bat *)",
      "Bash(.\\run_python.bat *)",
      "Bash(cmd //c run_python.bat *)",
      "Bash(cmd /c run_python.bat *)",
      "Bash(mkdir *)",
      "Bash(explorer.exe *)",
      "Bash(cmd //c start *)",
      "Bash(cmd /c start *)",
      "Bash(grep *)",
      "Bash(./instalar.bat *)",
      "Bash(ENCUESTA_HOGARES_NONINTERACTIVE=1 ./instalar.bat *)",
      "Write",
      "Edit",
      "WebFetch(domain:www4.ine.gub.uy)"
    ],
    "deny": [
      "Bash(git *)",
      "Bash(*git *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gate-primer-paso.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gate-notebook-sin-duplicados.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gate-resumen-cifras-inventadas.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gate-no-segundo-plano.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gate-no-git-indirecto.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gate-notebook-metrica-sin-grafica-o-cita.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gate-notebook-graficas-faltantes.cjs\""
          }
        ]
      }
    ]
  }
}
